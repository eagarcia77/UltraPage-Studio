{
  "name": "curralume-studio",
  "version": "1.1.0",
  "type": "module",
  "author": "Eduardo Augusto García Rodríguez",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "audit:design-preview": "node scripts/audit-design-preview.mjs",
    "audit:native-tools": "node scripts/audit-native-tools.mjs",
    "audit:qti21": "node scripts/audit-qti21.mjs",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p $PORT",
