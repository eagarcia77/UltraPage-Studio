    "clsx": "2.1.1",
    "docx": "^9.7.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pdfkit": "^0.20.2",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "mammoth": "^1.9.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "mammoth": {
      "argparse": "2.0.1"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
